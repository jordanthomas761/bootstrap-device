# Managed by roles/k8s_control_plane/tasks/argocd.yml — do not hand-edit.
#
# The read-only deploy key Argo CD uses to clone homelab-infra over SSH, so that
# repository can be private.
apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_repo_secret_name }}
  namespace: {{ argocd_namespace }}
  labels:
    # Marks this as a repository credential.
    argocd.argoproj.io/secret-type: repository
    # REQUIRED as well. Argo CD's settings informer only watches ConfigMaps and
    # Secrets carrying this label; without it the Secret exists as far as
    # kubectl is concerned while Argo CD cannot see it at all, and every
    # Application fails to sync with an authentication error that looks like a
    # bad key rather than a missing label.
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  type: git
  url: {{ homelab_infra_repo_url }}
  sshPrivateKey: |
{{ vault_argocd_repo_ssh_key | indent(4, true) }}

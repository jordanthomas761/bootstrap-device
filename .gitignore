# Ansible Galaxy local cache/lock (roles/collections are reinstalled via requirements.yml)
.ansible/

# macOS
.DS_Store

# Ansible retry files
*.retry

# Ansible Vault password file (never commit — see inventory/vault/argocd_dex.yml.example)
.vault_pass.txt

# Real vault-secrets files — only the .yml.example templates are tracked, so
# a real secret can never land in git unencrypted even by accident. Encrypted
# vault files are safe to force-add (git add -f) once ansible-vault encrypt
# has actually been run on them.
inventory/vault/*.yml

# Autoinstall seed ISO build output (contains a password hash + SSH pubkey)
/build/

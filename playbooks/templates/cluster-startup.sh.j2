#!/bin/bash
# Managed by playbooks/vm-host-lifecycle.yml — do not hand-edit.
#
# Brings the control-plane VM up after the Mac boots or you log in: start UTM
# and the VM, wait for SSH and the API server, then uncordon only the nodes that
# cluster-shutdown cordoned. Safe to run any time; every step is idempotent.
set -uo pipefail

UTMCTL="{{ utmctl_bin }}"
UTM_APP="{{ utm_app }}"
VM="{{ utm_vm_name }}"
CP="{{ vm_ctl_user }}@{{ cluster_cp_host }}"
KEY="{{ vm_ctl_key }}"
TIMEOUT={{ vm_startup_timeout }}

log() { echo "[cluster-startup] $(date '+%F %T') $*"; }
die() { log "ERROR: $*" >&2; exit 1; }

# vm-ctl can run only fixed verbs (ping, ready, uncordon, ...); see
# playbooks/vm-ctl-access.yml. There is no shell on the other end.
SSH=(ssh -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
  -o StrictHostKeyChecking=accept-new "$CP")

vm_state() { "$UTMCTL" status "$VM" 2>/dev/null | tr '[:upper:]' '[:lower:]'; }

# Retry helper: wait_for "<what>" <command...>, bounded by the shared timeout.
deadline=$((SECONDS + TIMEOUT))
wait_for() {
  local what="$1"
  shift
  until "$@" >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || die "timed out waiting for $what"
    sleep 5
  done
  log "$what: ready"
}

# utmctl drives the UTM app through Apple Events, so it only works inside the
# logged-in GUI session and crashes over SSH. Outside it, hand the work to the
# launchd agent that lives inside it and relay the result.
if [ "$(launchctl managername 2>/dev/null)" != "Aqua" ]; then
  exec "{{ vm_lifecycle_bin_dir }}/cluster-vm-gui-run" \
    "{{ vm_lifecycle_label_prefix }}.startup" "{{ vm_lifecycle_log_dir }}/startup.log"
fi

# UTM has to be running in this login session.
if ! pgrep -x UTM >/dev/null 2>&1; then
  log "launching UTM"
  open -g -a "$UTM_APP" || die "could not open $UTM_APP"
  sleep 5
fi

# At login UTM can be up before it lists its VMs ("Virtual machine not found",
# utmapp/UTM#6346), so retry rather than fail on the first look.
wait_for "UTM listing '$VM'" "$UTMCTL" status "$VM"

case "$(vm_state)" in
  *started*|*starting*)
    log "VM '$VM' is already running" ;;
  *)
    log "starting VM '$VM'"
    "$UTMCTL" start "$VM" || die "utmctl start failed (is the name right? try: $UTMCTL list)" ;;
esac

wait_for "SSH to $CP" "${SSH[@]}" ping
wait_for "the API server" "${SSH[@]}" ready

log "uncordoning nodes that cluster-shutdown cordoned"
"${SSH[@]}" uncordon
log "done"

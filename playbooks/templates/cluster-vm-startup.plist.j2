<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by playbooks/vm-host-lifecycle.yml — do not edit by hand. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ vm_lifecycle_label_prefix }}.startup</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ vm_lifecycle_bin_dir }}/cluster-startup</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- There is no launchd key for "start N seconds after login". The script
         starts the VM and then retries until SSH and the API answer, so it
         needs no head start. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- utmctl drives the UTM GUI app, which only exists in a logged-in
         session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>{{ vm_lifecycle_log_dir }}/startup.log</string>
    <key>StandardErrorPath</key>
    <string>{{ vm_lifecycle_log_dir }}/startup.err.log</string>
</dict>
</plist>

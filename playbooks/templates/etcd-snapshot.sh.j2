#!/bin/bash
# Managed by playbooks/etcd-snapshot-backup.yml — do not hand-edit.
#
# Takes a verified etcd snapshot and ships it off the control plane.
#
# Driven by crictl, NOT kubectl, on purpose. kubectl needs a working apiserver,
# and the moment you most want a backup is the moment the apiserver is broken.
# crictl talks to containerd directly, so this keeps working with the control
# plane in pieces. Same reasoning puts this in a systemd timer on the host
# rather than a CronJob in the cluster: a backup that needs the cluster healthy
# in order to run is not a backup.
set -euo pipefail

STAGE_DIR="{{ etcd_snapshot_stage_dir }}"
KEEP_LOCAL={{ etcd_snapshot_keep_local }}
KEEP_REMOTE={{ etcd_snapshot_keep_remote }}
REMOTE_ENABLED="{{ 'yes' if etcd_snapshot_remote_enabled else 'no' }}"
NFS_HOST="{{ etcd_snapshot_nfs_host }}"
NFS_EXPORT="{{ etcd_snapshot_nfs_export }}"
NFS_OPTIONS="{{ etcd_snapshot_nfs_options }}"
NFS_MOUNTPOINT="{{ etcd_snapshot_nfs_mountpoint }}"
NFS_SUBDIR="{{ etcd_snapshot_nfs_subdir }}"

CERTS="--cacert=/etc/kubernetes/pki/etcd/ca.crt \
--cert=/etc/kubernetes/pki/etcd/server.crt \
--key=/etc/kubernetes/pki/etcd/server.key"

log() { echo "[etcd-snapshot] $*"; }
die() { echo "[etcd-snapshot] ERROR: $*" >&2; exit 1; }

CID="$(crictl ps --name etcd -q 2>/dev/null | head -1)"
[ -n "$CID" ] || die "no running etcd container found via crictl"

TS="$(date -u +%Y%m%dT%H%M%SZ)"
NAME="etcd-${TS}.db"

# etcdctl runs inside the container, so it can only write where the container
# can write. /var/lib/etcd is the one host-mounted writable path in kubeadm's
# etcd pod, so the snapshot is staged there and moved straight out. The name is
# dot-prefixed while in flight so a half-written file is obviously not a
# finished snapshot if this dies midway.
IN_CONTAINER_TMP="/var/lib/etcd/.snapshot-inflight.db"
HOST_TMP="/var/lib/etcd/.snapshot-inflight.db"

cleanup() { rm -f "$HOST_TMP"; }
trap cleanup EXIT

log "taking snapshot"
crictl exec "$CID" etcdctl $CERTS snapshot save "$IN_CONTAINER_TMP" >/dev/null 2>&1 \
  || die "etcdctl snapshot save failed"

# Verify BEFORE moving it anywhere. `snapshot status` parses the file and reads
# its hash, so it fails on a truncated or corrupt snapshot -- the difference
# between having a backup and having a file. It has to run while the snapshot is
# still inside the container's view, hence the check happening here and not
# after the move.
log "verifying snapshot"
STATUS_JSON="$(crictl exec "$CID" etcdctl snapshot status "$IN_CONTAINER_TMP" --write-out=json 2>/dev/null)" \
  || die "snapshot verification failed -- refusing to keep an unverifiable file"

REVISION="$(printf '%s' "$STATUS_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["revision"])' 2>/dev/null || echo 0)"
KEYS="$(printf '%s' "$STATUS_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["totalKey"])' 2>/dev/null || echo 0)"
[ "$KEYS" -gt 0 ] || die "snapshot reports 0 keys -- refusing to keep it"
log "verified: revision=${REVISION} keys=${KEYS}"

mkdir -p "$STAGE_DIR"
chmod 0700 "$STAGE_DIR"
mv "$HOST_TMP" "${STAGE_DIR}/${NAME}"
trap - EXIT
chmod 0600 "${STAGE_DIR}/${NAME}"

# --- companion artifacts -------------------------------------------------
#
# An etcd snapshot on its own does NOT restore a cluster. Every ServiceAccount
# token in it was signed by sa.key and every kubelet and admin certificate by
# ca.key, both of which live on the filesystem and are NOT inside the snapshot.
# Restore a snapshot onto a control plane with a freshly generated CA and you
# get a cluster holding all the right data where nothing can authenticate.
# So the PKI ships alongside, sharing the snapshot's timestamp to make the
# pairing obvious at restore time.
PKI_ARCHIVE="${STAGE_DIR}/pki-${TS}.tar.gz"
tar czf "$PKI_ARCHIVE" -C /etc/kubernetes pki 2>/dev/null \
  && chmod 600 "$PKI_ARCHIVE" \
  && log "packaged control-plane PKI ($(du -h "$PKI_ARCHIVE" | cut -f1))" \
  || { rm -f "$PKI_ARCHIVE"; PKI_ARCHIVE=""; log "WARNING: could not package /etc/kubernetes/pki"; }

# The Sealed Secrets controller key. Losing it makes every SealedSecret in git
# permanently undecryptable. It is technically inside the etcd snapshot already
# -- it is a Secret in kube-system -- but recovering it that way means restoring
# etcd first and having the at-rest encryption key to hand. A direct copy turns
# a three-step recovery into a one-step one.
#
# Best effort on purpose: this is the only part of the script that needs a
# working apiserver, and a snapshot taken while the API is down is exactly the
# snapshot worth keeping. A failure here must never fail the run.
SS_ARCHIVE="${STAGE_DIR}/sealed-secrets-keys-${TS}.yaml"
if kubectl --kubeconfig=/etc/kubernetes/admin.conf -n kube-system get secret \
     -l sealedsecrets.bitnami.com/sealed-secrets-key -o yaml > "$SS_ARCHIVE" 2>/dev/null \
   && grep -q "tls.key" "$SS_ARCHIVE"; then
  chmod 600 "$SS_ARCHIVE"
  log "exported sealed-secrets controller key(s)"
else
  rm -f "$SS_ARCHIVE"; SS_ARCHIVE=""
  log "WARNING: could not export sealed-secrets keys (apiserver down?) -- continuing"
fi

gzip -f "${STAGE_DIR}/${NAME}"
ARCHIVE="${STAGE_DIR}/${NAME}.gz"
log "staged $(du -h "$ARCHIVE" | cut -f1) at ${ARCHIVE}"

if [ "$REMOTE_ENABLED" = "yes" ]; then
  # NFS rather than scp/rsync, because DSM only grants SSH to accounts in the
  # administrators group -- so an SSH-based copy would mean parking a key that
  # grants NAS admin on the control plane, which is the machine most exposed to
  # the cluster. An NFS export restricted to this host's IP needs no account and
  # no stored credential at all.
  log "mounting ${NFS_HOST}:${NFS_EXPORT}"
  mkdir -p "$NFS_MOUNTPOINT"

  # Always unmount on the way out, including on failure. A left-behind mount
  # makes the next run look like it succeeded against a stale handle, and a
  # hung NFS mount on the control plane is its own problem.
  nfs_cleanup() { umount "$NFS_MOUNTPOINT" 2>/dev/null || true; }

  mount -t nfs -o "$NFS_OPTIONS" "${NFS_HOST}:${NFS_EXPORT}" "$NFS_MOUNTPOINT" \
    || die "cannot mount ${NFS_HOST}:${NFS_EXPORT} -- snapshot is staged locally but NOT off-host"
  trap nfs_cleanup EXIT

  DEST="${NFS_MOUNTPOINT}/${NFS_SUBDIR}"
  mkdir -p "$DEST" || die "cannot create ${DEST} on the export -- check the export's squash setting"

  # Copy to a temp name and rename into place. A rename within the same
  # filesystem is atomic, so a run interrupted mid-copy never leaves a
  # half-written file that looks like a finished snapshot.
  # Copy to a dot-prefixed temp name and rename into place. A rename within one
  # filesystem is atomic, so an interrupted run never leaves a half-written file
  # that looks like a finished snapshot.
  ship() {
    local src="$1" base
    base=$(basename "$src")
    cp "$src" "${DEST}/.${base}.partial" || return 1
    mv "${DEST}/.${base}.partial" "${DEST}/${base}" || return 1
    return 0
  }

  ship "$ARCHIVE" \
    || die "copy to ${DEST} failed -- snapshot is staged locally but NOT off-host"

  # The companions are shipped best-effort: a snapshot that reached the far end
  # is worth keeping even if the PKI copy failed, and dying here would leave the
  # export holding a snapshot while the run reports failure.
  [ -n "$PKI_ARCHIVE" ] && { ship "$PKI_ARCHIVE" && log "shipped PKI" || log "WARNING: PKI copy failed"; }
  [ -n "$SS_ARCHIVE" ]  && { ship "$SS_ARCHIVE"  && log "shipped sealed-secrets keys" || log "WARNING: sealed-secrets copy failed"; }

  # Verify it is actually there and the right size, rather than trusting that
  # cp returned 0 against a mount that silently went read-only.
  SRC_SIZE=$(stat -c%s "$ARCHIVE")
  DST_SIZE=$(stat -c%s "${DEST}/$(basename "$ARCHIVE")" 2>/dev/null || echo 0)
  [ "$SRC_SIZE" = "$DST_SIZE" ] \
    || die "off-host copy is ${DST_SIZE} bytes but the source is ${SRC_SIZE} -- not trusting it"

  # Prune the off-host copies too, or the export grows without bound -- which is
  # how backup targets quietly fill up and start failing.
  # shellcheck disable=SC2012
  for pat in 'etcd-*.db.gz' 'pki-*.tar.gz' 'sealed-secrets-keys-*.yaml'; do
    # shellcheck disable=SC2012
    ls -1t "${DEST}"/$pat 2>/dev/null | tail -n +$((KEEP_REMOTE + 1)) | xargs -r rm -f \
      || log "WARNING: remote prune of $pat failed (the copy itself succeeded)"
  done

  REMOTE_COUNT=$(ls -1 "${DEST}"/etcd-*.db.gz 2>/dev/null | wc -l)
  nfs_cleanup
  trap - EXIT
  log "shipped ${SRC_SIZE} bytes off-host; ${REMOTE_COUNT} snapshot(s) now on the export"
else
  log "remote shipping DISABLED -- snapshot exists only on this host, which is the machine being protected against"
fi

# Local staging is a staging area, not the backup. Keep few.
# shellcheck disable=SC2012
for pat in 'etcd-*.db.gz' 'pki-*.tar.gz' 'sealed-secrets-keys-*.yaml'; do
  # shellcheck disable=SC2012
  ls -1t "${STAGE_DIR}"/$pat 2>/dev/null | tail -n +$((KEEP_LOCAL + 1)) | xargs -r rm -f
done
log "done"

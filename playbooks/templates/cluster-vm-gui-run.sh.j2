#!/bin/bash
# Managed by playbooks/vm-host-lifecycle.yml — do not hand-edit.
#
# Usage: cluster-vm-gui-run <launchd-label> <logfile>
#
# Runs a launchd agent that lives in this user's GUI session, waits for it to
# finish and prints what it logged. Exists because utmctl cannot run over SSH.
set -u

label="$1"
logfile="$2"
domain="gui/$(id -u)"

if ! launchctl print "$domain" >/dev/null 2>&1; then
  echo "No GUI session for $(id -un): log in to the Mac's desktop once, then retry." >&2
  exit 1
fi

before=0
[ -f "$logfile" ] && before=$(wc -l < "$logfile")

launchctl kickstart "$domain/$label" || {
  echo "Could not start $label. Is the agent installed? (playbooks/vm-host-lifecycle.yml)" >&2
  exit 1
}

sleep 2
while launchctl print "$domain/$label" 2>/dev/null | grep -q 'state = running'; do
  sleep 2
done

tail -n +"$((before + 1))" "$logfile" 2>/dev/null
code=$(launchctl print "$domain/$label" 2>/dev/null | awk '/last exit code/ {print $NF}')
exit "${code:-1}"
